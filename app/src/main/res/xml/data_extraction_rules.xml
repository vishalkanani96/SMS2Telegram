<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Exclude SharedPreferences from cloud backup and device transfer as they contain sensitive credentials -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
